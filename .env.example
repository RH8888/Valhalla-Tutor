# Application Configuration
APP_NAME=Valhalla Tutor
ENVIRONMENT=development
DEBUG=True

# Timezone Configuration
# Default timezone for calculations and display (configurable per user)
DEFAULT_TIMEZONE=Asia/Tehran

# Server Binding
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL 16)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password_here
POSTGRES_DB=valhalla_db

# Optional complete DATABASE_URL override. If left empty,
# it is automatically constructed from the POSTGRES_* fields above:
# postgresql+psycopg2://postgres:your_secure_password_here@localhost:5432/valhalla_db
DATABASE_URL=

# Security
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production

