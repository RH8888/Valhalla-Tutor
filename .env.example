# Application Environment (production / development)
APP_NAME=Valhalla Tutor
ENVIRONMENT=production
DEBUG=False

# Timezone Configuration (Default timezone for calendar and study planning)
DEFAULT_TIMEZONE=Asia/Tehran

# Host Port Binding (Application container listens on 8000; PORT sets the host loopback port)
PORT=8000

# Database Configuration (PostgreSQL 16)
# When running with Docker Compose, POSTGRES_SERVER must be 'db'
POSTGRES_SERVER=db
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_random_db_password
POSTGRES_DB=valhalla_db

# Security & Session Encryption
# Generate a 64-character hex string using: openssl rand -hex 32
SECRET_KEY=replace_with_strong_random_secret_key_min_32_chars

# Trusted Reverse Proxy IPs/CIDRs (host loopback, Docker bridge subnet)
TRUSTED_PROXIES=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8

# Automated Database Migrations (true: auto-run on startup; false: manual execution)
AUTO_MIGRATE=true

# Uvicorn Worker Process Concurrency (recommended: 2-4 for single VPS)
WEB_CONCURRENCY=2

